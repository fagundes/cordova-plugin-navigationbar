<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-navigationbar-inspector"
        version="1.0.0">
    <name>NavigationBarInspector</name>

    <js-module src="www/inspector.js" name="inspector">
        <clobbers target="window.NavigationBarInspector" />
    </js-module>

    <platform name="android">
        <source-file src="src/android/NavigationBarInspector.java"
                     target-dir="src/com/viniciusfagundes/cordova/plugin/navigationbar/test" />
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="NavigationBarInspector">
                <param name="android-package"
                       value="com.viniciusfagundes.cordova.plugin.navigationbar.test.NavigationBarInspector" />
            </feature>
        </config-file>
    </platform>
</plugin>
