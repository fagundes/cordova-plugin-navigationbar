{
  "name": "cordova-plugin-navigationbar-color",
  "version": "0.2.0",
  "description": "Cordova NavigationBar Plugin",
  "cordova": {
    "id": "cordova-plugin-navigationbar-color",
    "platforms": [
      "android"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fagundes/cordova-plugin-navigationbar"
  },
  "keywords": [
    "cordova",
    "navigationbar",
    "ecosystem:cordova",
    "cordova-android"
  ],
  "scripts": {
    "test": "node tests/run.js",
    "test:syntax": "node --check www/navigationbar.js && node --check src/browser/NavigationBarProxy.js && node --check tests/run.js && node --check tests/integration/prepare-app.js && node --check tests/integration/www/app.js && node --check tests/integration/inspector/www/inspector.js",
    "test:package": "npm pack --dry-run"
  },
  "engines": {
    "cordovaDependencies": {
      "0.1.0": {
        "cordova": ">=3.0.0"
      },
      "0.1.1": {
        "cordova-android": ">=7.1.4 <10.0.0"
      },
      "0.2.0": {
        "cordova-android": ">=10.1.2 <16.0.0"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "RELEASING.md",
    "plugin.xml",
    "src",
    "www"
  ],
  "author": "Vinicius Fagundes",
  "license": "Apache-2.0"
